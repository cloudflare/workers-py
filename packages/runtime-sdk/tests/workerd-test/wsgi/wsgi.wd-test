using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "python-wsgi",
      worker = (
        modules = [
          (name = "worker.py", pythonModule = embed "worker.py"),
          %PYTHON_MODULES
        ],
        bindings = [
          ( name = "SELF", service = "python-wsgi" ),
          # SELF.fetch does not serialize the response over HTTP, so it cannot
          # observe the runtime encoding the body. WSGI_HTTP goes through the
          # loopback HTTP socket below instead.
          ( name = "WSGI_HTTP", service = "wsgi-http" ),
          (
            name = "color",
            json = "%COLOR"
          ),
        ],
        compatibilityDate = "%COMPAT_DATE",
        compatibilityFlags = ["python_workers"],
      )
    ),
    ( name = "wsgi-http",
      external = (
        address = "loopback:wsgi-http",
        http = (),
      )
    ),
  ],
  sockets = [
    ( name = "wsgi-http",
      address = "loopback:wsgi-http",
      http = (),
      service = "python-wsgi",
    ),
  ],
);
